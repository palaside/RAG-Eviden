# ==============================================================================
# PDPA & SECURITY SHIELD (.gitignore) - RAG-Eviden (ชวกม.2)
# ==============================================================================

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.log

# Sensitive raw dumps & local heavy media
*.heic
*.mp4
*.edb
*.edb-wal
*.edb-shm
*.sst

# Heavy Raw Media Folders (> 100MB / thousands of unindexed images)
EDOK_NUI/Done/
EDOK_NUI/แชทที่ 1/
EDOK_NUI/แชทที่ 2/
EDOK_NUI/แชทที่ 3/
*.pdf

# General image ignore except smoking guns & PR Lens
*.png
*.jpg
*.jpeg
!EDOK_NUI/SMOKING_GUNS/*
!pr-lens/*.png
!pr-lens/*.svg

# Temp test files
test_p13.*
test_font.*
test_searchable_p1.*
test_thai_vector.pdf
*.rar
%USERPROFILE%/
EDOK_NUI/FOR TEST In EDOK_NUI/
EDOK_NUI/FACTORY2/
EDOK_NUI/_TEST_CLONES/

# Local IDE & OS
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Environment
.env
.venv/
env/

# Node & Next.js
node_modules/
.next/
*.node

# PR Lens upstream & write previews
pr-lens/
.pr-lens/
